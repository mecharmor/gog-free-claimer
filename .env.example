# ──────────────────────────────────────────────
# GOG Free Game Claimer — Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# cp .env.example .env

# Your GOG session cookies (required)
# See README.md for step-by-step instructions on how to get these.
# It should look like: gog-al=xxxxx; gog_us=xxxxx; ...
GOG_COOKIE=your_gog_cookies_here

# Cron schedule for --schedule mode (optional)
# Default: twice daily at 9am and 9pm
# Examples:
#   0 9,21 * * *   = 9:00am and 9:00pm every day  (default)
#   0 12 * * *     = noon every day
#   0 */6 * * *    = every 6 hours
CRON=0 9,21 * * *

# Optional Discord webhook URL for run notifications
DISCORD_WEBHOOK_URL=
